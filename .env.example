# NovaForge AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────
APP_NAME=NovaForge AI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/novaforge
POSTGRES_USER=postgres
POSTGRES_DB=novaforge

# ─── Neo4j ────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ─── Qdrant ───────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Providers ────────────────────────────────────────────────
# At least one is required for AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# ─── GitHub Integration ──────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ─── Monitoring ───────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp

# ─── Storage ──────────────────────────────────────────────────────
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30

# ─── Background Workers ───────────────────────────────────────────
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
